# Copy this file to .env and edit values for the target machine.

# Optional cloud provider. Leave empty for Ollama-only operation.
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai/v1
DEFAULT_PROVIDER=ollama

# AGX Orin Ollama server. Use 127.0.0.1 only when Ollama runs on this device.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b

# Voice input/output
# Whisper runs on the Nano when installed; Sarvam is the STT fallback.
STT_PROVIDER=whisper
WHISPER_MODEL=small
# Leave empty for automatic language detection, or use en, ta, hi, etc.
WHISPER_LANGUAGE=
WHISPER_TASK=transcribe
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
SARVAM_STT_LANGUAGE=en-IN
# Current implementation uses Sarvam Bulbul for reliable TTS.
TTS_PROVIDER=sarvam
SARVAM_TTS_LANGUAGE=ta-IN
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_TTS_MODEL=bulbul:v4-flash

# Paths are machine-specific; use a Linux path on Jetson.
DATA_DIR=./newsletter
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=department_kb

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
RETRIEVAL_TOP_K=8
CONTEXT_CHARS_PER_RESULT=1200

COLLEGE_URL=https://www.srmvalliammai.ac.in/
DEPARTMENT_URL=https://www.srmvalliammai.ac.in/department/department-of-artificial-intelligence-and-data-science
WEBSITE_MAX_PAGES=150

HOST=0.0.0.0
PORT=8000
